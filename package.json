{
  "name": "coronagraph",
  "version": "0.1.0",
  "description": "Personal intelligence platform for AI/ML research and cybersecurity",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "collect": "bun run src/jobs/collect.ts",
    "brief": "bun run src/jobs/brief.ts",
    "alerts": "bun run src/jobs/evaluate-alerts.ts",
    "bot": "bun run src/bot/bot.ts",
    "mcp": "bun run src/mcp/server.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.9",
    "pgvector": "^0.2.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "drizzle-orm": "^0.45.1",
    "grammy": "^1.40.1",
    "hono": "^4.12.3",
    "postgres": "^3.4.8",
    "zod": "^4.3.6"
  }
}
